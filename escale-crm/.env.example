# Port HTTP de l'application
PORT=3000
# Mettre true si le site est servi en HTTPS (recommandé en production)
COOKIE_SECURE=false

# Premier administrateur (créé au premier démarrage uniquement)
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Emplacement de la base SQLite
# DB_PATH=./data/escale-crm.sqlite

# --- Import automatique des demandes (Gmail en IMAP) ---
# Adresse Gmail qui reçoit les formulaires
IMAP_USER=
# Mot de passe d'application Google (16 caractères) : https://myaccount.google.com/apppasswords
IMAP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_MAILBOX=INBOX
# Filtre des e-mails de formulaire
FORM_SENDER=info@escaleenpresquile.bzh
FORM_SUBJECT=Nouvel envoi de formulaire
# Fréquence de vérification (minutes)
IMAP_POLL_MINUTES=5
# Au premier lancement, importer les demandes reçues depuis cette date (AAAA-MM-JJ)
IMAP_SINCE=2026-01-01
